<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edison -- Designer &amp; Developer</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { kanit: ['Kanit', 'sans-serif'] } },
      },
    };
  </script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body, #root { background-color: #0c0c0c; min-height: 100%; }
    html { overflow-x: clip; scroll-behavior: smooth; }
    body {
      font-family: 'Kanit', sans-serif;
      overflow-x: clip;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    img { display: block; max-width: 100%; }
    button { font-family: inherit; cursor: pointer; }

    .hero-heading {
      background: linear-gradient(180deg, #646973 0%, #bbccd7 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    .proj-card-wrap {
      position: sticky;
      top: calc(6rem + var(--card-offset, 0px));
      will-change: transform;
    }
    @media (min-width: 768px) {
      .proj-card-wrap { top: calc(8rem + var(--card-offset, 0px)); }
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0c0c0c; }
    ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 4px; }
  </style>
</head>

<body>
  <div id="root"></div>

  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>

  <script>
    (function () {
      const h = React.createElement;
      const { useState, useEffect, useRef, useMemo } = React;

      /* ---------------- utils ---------------- */
      const clamp = (v, min, max) => Math.min(Math.max(v, min), max);

      function interpolate(p, input, output) {
        const [i0, i1] = input;
        const [o0, o1] = output;
        if (i1 === i0) return o0;
        if (p <= i0) return o0;
        if (p >= i1) return o1;
        const t = (p - i0) / (i1 - i0);
        return o0 + (o1 - o0) * t;
      }

      /* ---------------- assets ---------------- */
      const PORTRAIT =
        'https://shrug-person-78902957.figma.site/_components/v2/d24c01ad3a56fc65e942a1f501eb73db42d7cf9a/Rectangle_40443.81459862.png';

      const ABOUT_DECOR = {
        moon: 'https://shrug-person-78902957.figma.site/_components/v2/ebb2b8f25d8e24d5f0a5ca8af4c950de81aa2fd7/moon_icon.11395d36.png',
        object:
          'https://shrug-person-78902957.figma.site/_components/v2/ebb2b8f25d8e24d5f0a5ca8af4c950de81aa2fd7/p59_1.4659672e.png',
        lego: 'https://shrug-person-78902957.figma.site/_components/v2/ebb2b8f25d8e24d5f0a5ca8af4c950de81aa2fd7/lego_icon-1.703bb594.png',
        group:
          'https://shrug-person-78902957.figma.site/_components/v2/ebb2b8f25d8e24d5f0a5ca8af4c950de81aa2fd7/Group_134-1.2e04f3ce.png',
      };

      const GIFS = [
        'https://motionsites.ai/assets/hero-space-voyage-preview-eECLH3Yc.gif',
        'https://motionsites.ai/assets/hero-codenest-preview-Cgppc2qV.gif',
        'https://motionsites.ai/assets/hero-vex-ventures-preview-BczMFIiw.gif',
        'https://motionsites.ai/assets/hero-stellar-ai-v2-preview-DjvxjG3C.gif',
        'https://motionsites.ai/assets/hero-asme-preview-B_nGDnTP.gif',
        'https://motionsites.ai/assets/hero-transform-data-preview-Cx5OU29N.gif',
        'https://motionsites.ai/assets/hero-vitara-preview-Cjz2QYyU.gif',
        'https://motionsites.ai/assets/hero-terra-preview-BFjrCr7T.gif',
        'https://motionsites.ai/assets/hero-skyelite-preview-DHaZIgUv.gif',
        'https://motionsites.ai/assets/hero-aethera-preview-DknSlcTa.gif',
        'https://motionsites.ai/assets/hero-designpro-preview-D8c5_een.gif',
        'https://motionsites.ai/assets/hero-stellar-ai-preview-D3HL6bw1.gif',
        'https://motionsites.ai/assets/hero-xportfolio-preview-D4A8maiC.gif',
        'https://motionsites.ai/assets/hero-orbit-web3-preview-BXt4OttD.gif',
        'https://motionsites.ai/assets/hero-nexora-preview-cx5HmUgo.gif',
        'https://motionsites.ai/assets/hero-evr-ventures-preview-DZxeVFEX.gif',
        'https://motionsites.ai/assets/hero-planet-orbit-preview-DWAP8Z1P.gif',
        'https://motionsites.ai/assets/hero-new-era-preview-CocuDUm9.gif',
        'https://motionsites.ai/assets/hero-wealth-preview-B70idl_u.gif',
        'https://motionsites.ai/assets/hero-luminex-preview-CxOP7ce6.gif',
        'https://motionsites.ai/assets/hero-celestia-preview-0yO3jXO8.gif',
      ];

      /* ---------------- content ---------------- */
      const ABOUT_TEXT =
        "I'm Edison, a designer and developer who loves turning ideas into clean, functional, and memorable digital products. Over the past five years I've worked across branding, web design, and front-end development, helping businesses present their best image. I care about the details others overlook — the spacing, the motion, the small moments that make a product feel alive. Let's build something worth remembering.";

      const STORY = [
        {
          year: '2019',
          title: 'The First Spark',
          desc: 'Opened a design tool for the first time and never looked back. Started teaching myself visual design through late-night tutorials and personal experiments.',
        },
        {
          year: '2021',
          title: 'First Real Client',
          desc: 'Delivered my first paid project — a small brand identity for a local studio. Learned that clear communication matters as much as clean pixels.',
        },
        {
          year: '2023',
          title: 'Going Independent',
          desc: 'Left the comfort of a steady role to work independently. Built websites, identities, and interfaces for startups and creators across three continents.',
        },
        {
          year: '2025',
          title: 'Design & Code',
          desc: 'Now blending design thinking with front-end development — shipping products end to end, from the first sketch to the final deploy.',
        },
      ];

      const PROJECTS = [
        {
          num: '01',
          category: 'Client',
          name: 'Nextlevel Studio',
          images: [
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055344_5eff02e0-87a5-41ce-b64f-eb08da8f33db.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055431_11d841fd-8b41-46a5-82e4-b04f2407a7d8.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055451_e317bf2d-28d4-48cc-86b0-6f72f25b6327.png&w=1280&q=85',
          ],
        },
        {
          num: '02',
          category: 'Personal',
          name: 'Aura Brand Identity',
          images: [
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055654_911201c5-36d9-4bc6-bac7-331adfce159f.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055723_5ceda0b8-d9c2-4665-b2e3-83ba19ba76d1.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055753_adc5dcbd-a8e6-49c0-b43a-9b030d835cea.png&w=1280&q=85',
          ],
        },
        {
          num: '03',
          category: 'Client',
          name: 'Solaris Digital',
          images: [
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055759_963cfb0b-4bd1-4b0f-9d0a-09bd6cf95b2f.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_060108_438f781a-9846-4dcc-89ab-c4e6cb830f5b.png&w=1280&q=85',
            'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260412_055818_9d062121-ad7e-46b9-999a-1a6a692ef1ee.png&w=1280&q=85',
          ],
        },
      ];

      /* =========================================================
         REUSABLE COMPONENTS
         ========================================================= */

      function FadeIn(props) {
        const {
          children, delay = 0, duration = 0.7, x = 0, y = 30,
          className, style, as = 'div',
        } = props;

        const ref = useRef(null);
        const [visible, setVisible] = useState(false);

        useEffect(function () {
          const el = ref.current;
          if (!el) return;
          if (typeof IntersectionObserver === 'undefined') {
            setVisible(true);
            return;
          }
          const io = new IntersectionObserver(
            function (entries) {
              for (let i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  setVisible(true);
                  io.disconnect();
                }
              }
            },
            { rootMargin: '50px', threshold: 0 }
          );
          io.observe(el);
          return function () { io.disconnect(); };
        }, []);

        return h(
          as,
          {
            ref: ref,
            className: className,
            style: Object.assign(
              {
                opacity: visible ? 1 : 0,
                transform: visible
                  ? 'translate3d(0px, 0px, 0px)'
                  : 'translate3d(' + x + 'px, ' + y + 'px, 0px)',
                transition:
                  'opacity ' + duration + 's cubic-bezier(0.25,0.1,0.25,1) ' + delay + 's, ' +
                  'transform ' + duration + 's cubic-bezier(0.25,0.1,0.25,1) ' + delay + 's',
                willChange: 'transform, opacity',
              },
              style
            ),
          },
          children
        );
      }

      function Magnet(props) {
        const {
          children, padding = 150, strength = 3,
          activeTransition = 'transform 0.3s ease-out',
          inactiveTransition = 'transform 0.6s ease-in-out',
          className, style,
        } = props;

        const ref = useRef(null);
        const [pos, setPos] = useState({ x: 0, y: 0 });
        const [active, setActive] = useState(false);

        useEffect(function () {
          function onMove(e) {
            const el = ref.current;
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;
            const inside =
              Math.abs(dx) < rect.width / 2 + padding &&
              Math.abs(dy) < rect.height / 2 + padding;

            if (inside) {
              setActive(true);
              setPos({ x: dx / strength, y: dy / strength });
            } else {
              setActive(false);
              setPos({ x: 0, y: 0 });
            }
          }
          window.addEventListener('mousemove', onMove, { passive: true });
          return function () { window.removeEventListener('mousemove', onMove); };
        }, [padding, strength]);

        return h(
          'div',
          {
            ref: ref,
            className: className,
            style: Object.assign(
              {
                transform: 'translate3d(' + pos.x + 'px, ' + pos.y + 'px, 0px)',
                transition: active ? activeTransition : inactiveTransition,
                willChange: 'transform',
              },
              style
            ),
          },
          children
        );
      }

      function AnimatedText(props) {
        const { text, className, style } = props;
        const ref = useRef(null);
        const [progress, setProgress] = useState(0);

        useEffect(function () {
          let raf = 0;
          function update() {
            raf = 0;
            const el = ref.current;
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const vh = window.innerHeight;
            const startY = vh * 0.8;
            const endY = vh * 0.2 - rect.height;
            const total = startY - endY;
            const p = total > 0 ? (startY - rect.top) / total : 0;
            setProgress(clamp(p, 0, 1));
          }
          function onScroll() {
            if (!raf) raf = requestAnimationFrame(update);
          }
          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          return function () {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
            if (raf) cancelAnimationFrame(raf);
          };
        }, []);

        const spans = useMemo(function () {
          const totalChars = text.length || 1;
          const words = text.split(' ');
          const out = [];
          let idx = 0;

          words.forEach(function (word, wi) {
            const letters = [];
            for (let ci = 0; ci < word.length; ci++) {
              const i = idx++;
              const start = (i / totalChars) * 0.8;
              const end = start + 0.2;
              const t = clamp((progress - start) / (end - start), 0, 1);
              letters.push(
                h('span', { key: 'c' + i, style: { opacity: 0.2 + 0.8 * t } }, word[ci])
              );
            }
            out.push(
              h('span', { key: 'w' + wi, style: { display: 'inline-block', whiteSpace: 'nowrap' } }, letters)
            );
            if (wi < words.length - 1) {
              idx++;
              out.push(
                h('span', { key: 's' + wi, style: { display: 'inline-block', whiteSpace: 'pre' } }, '\u00A0')
              );
            }
          });
          return out;
        }, [text, progress]);

        return h('p', { ref: ref, className: className, style: style }, spans);
      }

      function ContactButton(props) {
        const label = (props && props.label) || 'Contact Me';
        return h(
          'button',
          {
            type: 'button',
            className:
              'rounded-full text-white font-medium uppercase tracking-widest ' +
              'px-8 py-3 sm:px-10 sm:py-3.5 md:px-12 md:py-4 ' +
              'text-xs sm:text-sm md:text-base ' +
              'transition-transform duration-200 hover:scale-[1.03] active:scale-[0.98]',
            style: {
              background:
                'linear-gradient(123deg, #18011F 7%, #B600A8 37%, #7621B0 72%, #BE4C00 100%)',
              boxShadow:
                '0px 4px 4px rgba(181, 1, 167, 0.25), 4px 4px 12px #7721B1 inset',
              outline: '2px solid #FFFFFF',
              outlineOffset: '-3px',
            },
            onClick: function () {
              const el = document.getElementById('contact');
              if (el) el.scrollIntoView({ behavior: 'smooth' });
            },
          },
          label
        );
      }

      function LiveProjectButton() {
        return h(
          'button',
          {
            type: 'button',
            className:
              'rounded-full border-2 border-[#D7E2EA] text-[#D7E2EA] font-medium uppercase ' +
              'tracking-widest px-8 py-3 sm:px-10 sm:py-3.5 text-sm sm:text-base ' +
              'whitespace-nowrap transition-colors duration-200 hover:bg-[#D7E2EA]/10',
          },
          'View Project'
        );
      }

      /* =========================================================
         SECTIONS
         ========================================================= */

      function Navbar() {
        const links = [
          { label: 'About Me', href: '#about' },
          { label: 'Story', href: '#story' },
          { label: 'Projects', href: '#projects' },
          { label: 'Contact', href: '#contact' },
        ];

        return h(
          'nav',
          {
            className:
              'flex items-center justify-between px-6 md:px-10 pt-6 md:pt-8 relative z-20',
          },
          links.map(function (l) {
            return h(
              'a',
              {
                key: l.label,
                href: l.href,
                className:
                  'text-[#D7E2EA] font-medium uppercase tracking-wider ' +
                  'text-sm md:text-lg lg:text-[1.4rem] ' +
                  'transition-opacity duration-200 hover:opacity-70',
              },
              l.label
            );
          })
        );
      }

      function HeroSection() {
        return h(
          'section',
          {
            className: 'relative h-screen flex flex-col',
            style: { overflowX: 'clip' },
          },

          h(FadeIn, { delay: 0, y: -20, duration: 0.7 }, h(Navbar)),

          h(
            'div',
            { className: 'overflow-hidden' },
            h(
              FadeIn,
              { delay: 0.15, y: 40, duration: 0.7 },
              h(
                'h1',
                {
                  className:
                    'hero-heading font-black uppercase tracking-tight leading-none ' +
                    'whitespace-nowrap w-full ' +
                    'text-[14vw] sm:text-[15vw] md:text-[16vw] lg:text-[17.5vw] ' +
                    'mt-6 sm:mt-4 md:-mt-5',
                },
                "Hi, i'm edison"
              )
            )
          ),

          h(
            'div',
            {
              className:
                'absolute left-1/2 -translate-x-1/2 z-10 ' +
                'top-1/2 -translate-y-1/2 ' +
                'sm:top-auto sm:translate-y-0 sm:bottom-0 ' +
                'w-[280px] sm:w-[360px] md:w-[440px] lg:w-[520px]',
            },
            h(
              FadeIn,
              { delay: 0.6, y: 30, duration: 0.7 },
              h(
                Magnet,
                {
                  padding: 150,
                  strength: 3,
                  activeTransition: 'transform 0.3s ease-out',
                  inactiveTransition: 'transform 0.6s ease-in-out',
                },
                h('img', {
                  src: PORTRAIT,
                  alt: 'Edison portrait',
                  className: 'w-full h-auto object-contain select-none',
                  draggable: false,
                })
              )
            )
          ),

          h(
            'div',
            {
              className:
                'relative z-20 mt-auto flex items-end justify-between gap-4 ' +
                'px-6 md:px-10 pb-7 sm:pb-8 md:pb-10',
            },
            h(
              FadeIn,
              { delay: 0.35, y: 20, duration: 0.7 },
              h(
                'p',
                {
                  className:
                    'text-[#D7E2EA] font-light uppercase tracking-wide leading-snug ' +
                    'max-w-[160px] sm:max-w-[220px] md:max-w-[260px]',
                  style: { fontSize: 'clamp(0.75rem, 1.4vw, 1.5rem)' },
                },
                'a designer & developer crafting thoughtful digital experiences'
              )
            ),
            h(FadeIn, { delay: 0.5, y: 20, duration: 0.7 }, h(ContactButton))
          )
        );
      }

      /* ---------- Marquee ---------- */
      function MarqueeRow(props) {
        const { images, x, reverse } = props;
        return h(
          'div',
          { className: 'overflow-hidden', style: { width: '100%' } },
          h(
            'div',
            {
              className: 'flex gap-3',
              style: {
                transform: 'translate3d(' + x + 'px, 0, 0)',
                willChange: 'transform',
                width: 'max-content',
              },
            },
            images.map(function (src, i) {
              return h('img', {
                key: reverse + '-' + i,
                src: src,
                alt: '',
                loading: 'lazy',
                className: 'rounded-2xl object-cover shrink-0',
                style: { width: '420px', height: '270px' },
                draggable: false,
              });
            })
          )
        );
      }

      function MarqueeSection() {
        const ref = useRef(null);
        const [offset, setOffset] = useState(0);

        useEffect(function () {
          let raf = 0;
          function update() {
            raf = 0;
            const el = ref.current;
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const sectionTop = rect.top + window.scrollY;
            const value = (window.scrollY - sectionTop + window.innerHeight) * 0.3;
            setOffset(value);
          }
          function onScroll() {
            if (!raf) raf = requestAnimationFrame(update);
          }
          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          return function () {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
            if (raf) cancelAnimationFrame(raf);
          };
        }, []);

        const row1 = GIFS.slice(0, 11);
        const row2 = GIFS.slice(11);

        const TILE = 420;
        const GAP = 12;
        const width1 = row1.length * TILE + (row1.length - 1) * GAP;
        const width2 = row2.length * TILE + (row2.length - 1) * GAP;

        const mod1 = ((offset % width1) + width1) % width1;
        const mod2 = ((offset % width2) + width2) % width2;

        const x1 = -width1 + mod1;
        const x2 = -mod2;

        const tripled1 = row1.concat(row1, row1);
        const tripled2 = row2.concat(row2, row2);

        return h(
          'section',
          {
            ref: ref,
            className: 'relative bg-[#0C0C0C] pt-24 sm:pt-32 md:pt-40 pb-10',
            style: { overflowX: 'clip' },
          },
          h(
            'div',
            { className: 'flex flex-col gap-3' },
            h(MarqueeRow, { images: tripled1, x: x1, reverse: 'r1' }),
            h(MarqueeRow, { images: tripled2, x: x2, reverse: 'r2' })
          )
        );
      }

      /* ---------- About Me ---------- */
      function AboutSection() {
        const decor = [
          { src: ABOUT_DECOR.moon, alt: 'Moon', style: { top: '4%', left: '1%', width: 'clamp(120px, 14vw, 210px)' }, delay: 0.1, x: -80 },
          { src: ABOUT_DECOR.object, alt: '3D object', style: { bottom: '8%', left: '3%', width: 'clamp(100px, 12vw, 180px)' }, delay: 0.25, x: -80 },
          { src: ABOUT_DECOR.lego, alt: 'Lego', style: { top: '4%', right: '1%', width: 'clamp(120px, 14vw, 210px)' }, delay: 0.15, x: 80 },
          { src: ABOUT_DECOR.group, alt: '3D group', style: { bottom: '8%', right: '3%', width: 'clamp(130px, 15vw, 220px)' }, delay: 0.3, x: 80 },
        ];

        return h(
          'section',
          {
            id: 'about',
            className:
              'relative min-h-screen flex flex-col items-center justify-center ' +
              'px-5 sm:px-8 md:px-10 py-20',
            style: { overflowX: 'clip' },
          },

          decor.map(function (d, i) {
            return h(
              FadeIn,
              {
                key: 'decor-' + i,
                delay: d.delay,
                duration: 0.9,
                x: d.x,
                y: 0,
                className: 'absolute pointer-events-none select-none',
                style: Object.assign({ zIndex: 0 }, d.style),
              },
              h('img', {
                src: d.src,
                alt: d.alt,
                className: 'w-full h-auto',
                draggable: false,
                loading: 'lazy',
              })
            );
          }),

          h(
            'div',
            { className: 'relative z-10 w-full flex flex-col items-center' },
            h(
              'div',
              {
                className:
                  'flex flex-col items-center text-center gap-10 sm:gap-14 md:gap-16',
              },
              h(
                FadeIn,
                { delay: 0, y: 40, duration: 0.7 },
                h(
                  'h2',
                  {
                    className:
                      'hero-heading font-black uppercase leading-none tracking-tight text-center',
                    style: { fontSize: 'clamp(3rem, 12vw, 160px)' },
                  },
                  'About Me'
                )
              ),
              h(AnimatedText, {
                text: ABOUT_TEXT,
                className:
                  'text-[#D7E2EA] font-medium text-center leading-relaxed max-w-[560px]',
                style: { fontSize: 'clamp(1rem, 2vw, 1.35rem)' },
              })
            ),
            h(
              'div',
              { className: 'mt-16 sm:mt-20 md:mt-24' },
              h(FadeIn, { delay: 0.15, y: 20, duration: 0.7 }, h(ContactButton))
            )
          )
        );
      }

      /* ---------- Story ---------- */
      function StorySection() {
        return h(
          'section',
          {
            id: 'story',
            className:
              'relative bg-[#0C0C0C] px-5 sm:px-8 md:px-10 py-20 sm:py-24 md:py-32',
            style: { overflowX: 'clip' },
          },
          h(
            'h2',
            {
              className:
                'hero-heading font-black uppercase text-center leading-none tracking-tight ' +
                'mb-16 sm:mb-20 md:mb-28',
              style: { fontSize: 'clamp(3rem, 12vw, 160px)' },
            },
            'Story'
          ),

          h(
            'div',
            { className: 'relative max-w-4xl mx-auto' },

            /* vertical line */
            h('div', {
              className: 'absolute left-[10px] sm:left-[14px] top-2 bottom-2 w-px',
              style: { background: 'rgba(215, 226, 234, 0.15)' },
            }),

            STORY.map(function (item, i) {
              return h(
                FadeIn,
                { key: item.year, delay: i * 0.12, y: 30, duration: 0.7 },
                h(
                  'div',
                  {
                    className: 'relative pl-10 sm:pl-16 pb-14 sm:pb-20 last:pb-0',
                  },

                  /* dot */
                  h('div', {
                    className: 'absolute left-0 sm:left-1 top-2 w-5 h-5 sm:w-6 sm:h-6 rounded-full border-2',
                    style: {
                      borderColor: '#D7E2EA',
                      background: '#0C0C0C',
                      boxShadow: '0 0 0 6px rgba(12, 12, 12, 1)',
                    },
                  }),

                  /* year */
                  h(
                    'div',
                    {
                      className: 'hero-heading font-black leading-none mb-3',
                      style: { fontSize: 'clamp(2rem, 6vw, 4.5rem)' },
                    },
                    item.year
                  ),

                  /* title */
                  h(
                    'h3',
                    {
                      className: 'text-[#D7E2EA] font-medium uppercase tracking-wide mb-3',
                      style: { fontSize: 'clamp(1rem, 2vw, 1.5rem)' },
                    },
                    item.title
                  ),

                  /* desc */
                  h(
                    'p',
                    {
                      className: 'text-[#D7E2EA]/60 font-light leading-relaxed max-w-2xl',
                      style: { fontSize: 'clamp(0.9rem, 1.5vw, 1.1rem)' },
                    },
                    item.desc
                  )
                )
              );
            })
          )
        );
      }

      /* ---------- Projects ---------- */
      function useScrollProgress(ref) {
        const [p, setP] = useState(0);

        useEffect(function () {
          let raf = 0;
          function update() {
            raf = 0;
            const el = ref.current;
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const total = rect.height - window.innerHeight;
            const value = total > 0 ? -rect.top / total : 0;
            setP(clamp(value, 0, 1));
          }
          function onScroll() {
            if (!raf) raf = requestAnimationFrame(update);
          }
          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          return function () {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
            if (raf) cancelAnimationFrame(raf);
          };
        }, [ref]);

        return p;
      }

      function ProjectCard(props) {
        const { project, index, scale } = props;
        const radius = 'rounded-[40px] sm:rounded-[50px] md:rounded-[60px]';

        return h(
          'div',
          {
            className: 'proj-card-wrap',
            style: { '--card-offset': index * 28 + 'px' },
          },
          h(
            'div',
            {
              className:
                radius +
                ' border-2 border-[#D7E2EA] bg-[#0C0C0C] p-4 sm:p-6 md:p-8',
              style: {
                transform: 'scale(' + scale + ')',
                transformOrigin: 'top center',
                willChange: 'transform',
              },
            },

            h(
              'div',
              {
                className:
                  'flex flex-wrap items-center justify-between gap-4 sm:gap-6 ' +
                  'px-2 sm:px-4 md:px-6 pt-2 pb-5 sm:pb-6 md:pb-8',
              },
              h(
                'div',
                { className: 'flex items-center gap-4 sm:gap-6 md:gap-8' },
                h(
                  'span',
                  {
                    className: 'hero-heading font-black leading-none',
                    style: { fontSize: 'clamp(3rem, 8vw, 110px)' },
                  },
                  project.num
                ),
                h(
                  'div',
                  { className: 'flex flex-col gap-1' },
                  h(
                    'span',
                    {
                      className:
                        'text-[#D7E2EA]/50 uppercase tracking-widest text-[0.65rem] sm:text-xs',
                    },
                    project.category
                  ),
                  h(
                    'span',
                    {
                      className: 'text-[#D7E2EA] font-medium uppercase leading-tight',
                      style: { fontSize: 'clamp(1rem, 2vw, 1.8rem)' },
                    },
                    project.name
                  )
                )
              ),
              h(LiveProjectButton)
            ),

            h(
              'div',
              { className: 'flex gap-3 sm:gap-4 md:gap-5' },

              h(
                'div',
                { className: 'w-[40%] flex flex-col gap-3 sm:gap-4 md:gap-5' },
                h('img', {
                  src: project.images[0],
                  alt: project.name + ' image 1',
                  loading: 'lazy',
                  className: radius + ' w-full object-cover',
                  style: { height: 'clamp(130px, 16vw, 230px)' },
                }),
                h('img', {
                  src: project.images[1],
                  alt: project.name + ' image 2',
                  loading: 'lazy',
                  className: radius + ' w-full object-cover',
                  style: { height: 'clamp(160px, 22vw, 340px)' },
                })
              ),

              h(
                'div',
                { className: 'w-[60%]' },
                h('img', {
                  src: project.images[2],
                  alt: project.name + ' image 3',
                  loading: 'lazy',
                  className: radius + ' w-full h-full object-cover',
                })
              )
            )
          )
        );
      }

      function ProjectsSection() {
        const containerRef = useRef(null);
        const progress = useScrollProgress(containerRef);
        const total = PROJECTS.length;

        return h(
          'section',
          {
            id: 'projects',
            className:
              'relative z-10 bg-[#0C0C0C] ' +
              'px-5 sm:px-8 md:px-10 py-20 sm:py-24 md:py-28',
            style: { overflowX: 'clip' },
          },
          h(
            'h2',
            {
              className:
                'hero-heading font-black uppercase text-center leading-none tracking-tight ' +
                'mb-12 sm:mb-16 md:mb-20',
              style: { fontSize: 'clamp(3rem, 12vw, 160px)' },
            },
            'Projects'
          ),
          h(
            'div',
            { ref: containerRef, className: 'relative' },
            PROJECTS.map(function (project, i) {
              const targetScale = 1 - (total - 1 - i) * 0.03;
              const scale = interpolate(progress, [i / total, 1], [1, targetScale]);
              return h(
                'div',
                { key: project.num, className: 'h-[85vh]' },
                h(ProjectCard, { project: project, index: i, scale: scale })
              );
            })
          )
        );
      }

      /* ---------- Footer / Contact ---------- */
      function FooterSection() {
        const links = [
          { label: 'Email', value: 'hello@edison.design', href: 'mailto:hello@edison.design' },
          { label: 'GitHub', value: '@edison', href: 'https://github.com' },
          { label: 'LinkedIn', value: '/in/edison', href: 'https://linkedin.com' },
          { label: 'Twitter', value: '@edison', href: 'https://twitter.com' },
        ];

        return h(
          'footer',
          {
            id: 'contact',
            className:
              'relative bg-[#0C0C0C] px-5 sm:px-8 md:px-10 py-20 sm:py-24 md:py-32',
          },
          h(
            'div',
            { className: 'max-w-5xl mx-auto flex flex-col items-center text-center' },

            h(
              FadeIn,
              { delay: 0, y: 40, duration: 0.7 },
              h(
                'h2',
                {
                  className:
                    'hero-heading font-black uppercase leading-none tracking-tight mb-8',
                  style: { fontSize: 'clamp(3rem, 12vw, 160px)' },
                },
                'Contact'
              )
            ),

            h(
              FadeIn,
              { delay: 0.1, y: 20, duration: 0.7 },
              h(
                'p',
                {
                  className:
                    'text-[#D7E2EA] font-light leading-relaxed max-w-lg mb-12',
                  style: { fontSize: 'clamp(0.95rem, 1.6vw, 1.2rem)' },
                },
                'Have an idea, a project, or just want to say hi? I\'m always open to a good conversation.'
              )
            ),

            h(
              FadeIn,
              { delay: 0.15, y: 20, duration: 0.7 },
              h(
                'div',
                { className: 'mb-16' },
                h(ContactButton, { label: 'Say Hello' })
              )
            ),

            h(
              FadeIn,
              { delay: 0.2, y: 20, duration: 0.7 },
              h(
                'div',
                {
                  className:
                    'grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-12 w-full max-w-2xl mb-16',
                },
                links.map(function (l) {
                  return h(
                    'a',
                    {
                      key: l.label,
                      href: l.href,
                      target: l.href.startsWith('http') ? '_blank' : undefined,
                      rel: l.href.startsWith('http') ? 'noopener noreferrer' : undefined,
                      className: 'group flex flex-col gap-1',
                    },
                    h(
                      'span',
                      {
                        className:
                          'text-[#D7E2EA]/40 uppercase tracking-widest text-[0.65rem] sm:text-xs',
                      },
                      l.label
                    ),
                    h(
                      'span',
                      {
                        className:
                          'text-[#D7E2EA] font-medium text-sm sm:text-base ' +
                          'group-hover:opacity-70 transition-opacity duration-200',
                      },
                      l.value
                    )
                  );
                })
              )
            ),

            h(
              'div',
              {
                className:
                  'w-full pt-8 border-t border-[#D7E2EA]/10 flex flex-col sm:flex-row ' +
                  'items-center justify-between gap-4',
              },
              h(
                'span',
                { className: 'text-[#D7E2EA]/40 text-xs uppercase tracking-widest' },
                '© 2025 Edison. All rights reserved.'
              ),
              h(
                'span',
                { className: 'text-[#D7E2EA]/40 text-xs uppercase tracking-widest' },
                'Designed & built by Edison'
              )
            )
          )
        );
      }

      /* =========================================================
         APP ROOT
         ========================================================= */
      function App() {
        return h(
          'div',
          {
            style: {
              backgroundColor: '#0C0C0C',
              overflowX: 'clip',
              fontFamily: "'Kanit', sans-serif",
            },
          },
          h(HeroSection),
          h(MarqueeSection),
          h(AboutSection),
          h(StorySection),
          h(ProjectsSection),
          h(FooterSection)
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(h(App));
    })();
  </script>
</body>
</html>
